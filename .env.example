# Neon console -> Connection Details -> pooled Postgres connection string (NOT the Neon API key).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require"
# Optional but recommended: Neon direct (non-pooler) connection for db:push, db:generate, db:migrate.
DATABASE_DIRECT_URL=""
# 32+ random characters, generate: openssl rand -base64 48
BETTER_AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Public origin. E.g. http://localhost:3000 in dev and https://gym.example.com in production.
BETTER_AUTH_URL="http://localhost:3000"
# Your gym owner credentials. Use these ONLY with npm run db:bootstrap.
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
BOOTSTRAP_OWNER_NAME="Gym Owner"
BOOTSTRAP_OWNER_PASSWORD="REPLACE_WITH_A_UNIQUE_16_CHARACTER_PASSWORD"
# Cloudinary dashboard -> API Environment variable credentials.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Explicit local-only preview without a database. Does NOT persist records.
# Never use this for real gym operations. It is disabled outside npm run dev.
DEMO_MODE="false"
